[Unit]
Description=Remont web app
After=network-online.target
Wants=network-online.target

[Service]
User=remont
WorkingDirectory=/srv/remont/app
EnvironmentFile=/etc/remont.env
ExecStart=/usr/bin/node server.mjs --prod
Restart=always
RestartSec=3
# uploads and renders live in /srv/remont/app/.data
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
